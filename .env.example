# TiDB Cloud Serverless
TIDB_HOST=gatewayxxxx.tidb.cloud
TIDB_PORT=4000
TIDB_USER=xxxx
TIDB_PASSWORD=xxxx
TIDB_NAME=prabu_db
TIDB_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
DB_PREFIX=prabu_
DB_SSL=1

# Vercel Blob (token dari project Vercel -> Storage -> Blob)
BLOB_READ_WRITE_TOKEN=

# Akun pertama. Dipakai sekali oleh: npm run install-db
ADMIN_USER=admin
ADMIN_PASS=ganti_password_panjang

# Opsi
TZ=Asia/Jakarta
WA_NUMBER=6282246838645
