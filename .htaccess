Options -Indexes

RewriteEngine On
RewriteBase /

# HTML hanya boleh diakses lewat app.php yang memeriksa sesi.
RewriteCond %{REQUEST_URI} ^/prabu-office(%20| )
RewriteRule ^.*$ app.php [R=302,L]
RewriteRule ^$ app.php [L]
RewriteRule ^index\.php$ app.php [L]
RewriteRule ^storage/ - [F,L]

<FilesMatch "^(config\.php|config\.example\.php|schema\.sql|router\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
